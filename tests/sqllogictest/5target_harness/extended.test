# 5-target extended sqllogictest fixture.
#
# Expanded coverage for the 5-target matrix (Rust / Python / C / Zig / Go).
# All records are CREATE TABLE / INSERT / SELECT only — the harness drivers
# don't dispatch UPDATE/DELETE/CREATE-VIEW from SQL text, so coverage of
# those is exercised separately (parts/compiler/parts/{update,delete}-compile).
#
# Format: same thin subset as canonical.test —
#   * `statement ok` — SQL must execute without error
#   * `query <typestring> nosort` — SQL must execute and emit the listed
#     rows in the order shown, value-per-line.
# Blank lines separate records. Lines starting with `#` are comments.
#
# DEFER bias: queries that use features outside the v1 steel-thread
# (JOINs through SQL-text, CTE, UNION beyond simple, scalar/EXISTS/IN
# subqueries) are deliberately included so the matrix surfaces parity
# breadth + honest gaps. A DEFER on every target is the documented
# expected outcome — not a regression.

# =============================================================
# Section 1: base tables for primary scenarios
# =============================================================

statement ok
CREATE TABLE nums (id INTEGER, val INTEGER)

statement ok
INSERT INTO nums VALUES (1, 10)

statement ok
INSERT INTO nums VALUES (2, 20)

statement ok
INSERT INTO nums VALUES (3, 30)

statement ok
INSERT INTO nums VALUES (4, 40)

statement ok
INSERT INTO nums VALUES (5, 50)

statement ok
CREATE TABLE people (id INTEGER, name TEXT)

statement ok
INSERT INTO people VALUES (1, 'alice')

statement ok
INSERT INTO people VALUES (2, 'bob')

statement ok
INSERT INTO people VALUES (3, 'carol')

statement ok
INSERT INTO people VALUES (4, 'dave')

statement ok
CREATE TABLE nullable (k INTEGER, v INTEGER)

statement ok
INSERT INTO nullable VALUES (1, 100)

statement ok
INSERT INTO nullable VALUES (2, 200)

statement ok
INSERT INTO nullable VALUES (3, NULL)

statement ok
INSERT INTO nullable VALUES (4, 400)

