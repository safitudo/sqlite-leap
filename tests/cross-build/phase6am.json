{
  "phase": "6am",
  "description": "Phase 6am gate — NOT NULL column constraint. New runtime error RUNTIME_NOT_NULL_VIOLATION.",
  "cases": [
    {
      "name": "not-null-accepts-value",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER NOT NULL, b INTEGER);", "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1, 10);",                    "expect": {"rows": []}},
        {"sql": "SELECT a FROM t;",                                 "expect": {"rows": [[1]]}}
      ]
    },
    {
      "name": "not-null-rejects-explicit-null",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER NOT NULL);",  "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (NULL);",           "expect": {"error": "RUNTIME_NOT_NULL_VIOLATION"}}
      ]
    },
    {
      "name": "not-null-rejects-omitted-column-without-default",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER NOT NULL, b INTEGER);", "expect": {"rows": []}},
        {"sql": "INSERT INTO t (b) VALUES (10);",                    "expect": {"error": "RUNTIME_NOT_NULL_VIOLATION"}}
      ]
    },
    {
      "name": "not-null-with-default-accepts-omitted",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER NOT NULL DEFAULT 0, b INTEGER);", "expect": {"rows": []}},
        {"sql": "INSERT INTO t (b) VALUES (10);",                             "expect": {"rows": []}},
        {"sql": "SELECT a FROM t;",                                           "expect": {"rows": [[0]]}}
      ]
    },
    {
      "name": "not-null-with-null-default-rejects-omitted",
      "description": "NOT NULL with DEFAULT NULL should reject omission at runtime.",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER NOT NULL DEFAULT NULL, b INTEGER);", "expect": {"rows": []}},
        {"sql": "INSERT INTO t (b) VALUES (10);",                                "expect": {"error": "RUNTIME_NOT_NULL_VIOLATION"}}
      ]
    },
    {
      "name": "not-null-text-column",
      "program": [
        {"sql": "CREATE TABLE t (name TEXT NOT NULL);", "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (NULL);",          "expect": {"error": "RUNTIME_NOT_NULL_VIOLATION"}}
      ]
    },
    {
      "name": "not-null-update-rejects",
      "description": "UPDATE that would put NULL in a NOT NULL column also rejects.",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER NOT NULL);",  "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",               "expect": {"rows": []}},
        {"sql": "UPDATE t SET a = NULL;",                  "expect": {"error": "RUNTIME_NOT_NULL_VIOLATION"}}
      ]
    }
  ]
}
