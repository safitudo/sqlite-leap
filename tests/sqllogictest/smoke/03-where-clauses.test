# Smoke: WHERE with equality, inequality, range, BETWEEN, AND, OR.

statement ok
CREATE TABLE t (id INTEGER, score INTEGER, name TEXT)

statement ok
INSERT INTO t VALUES (1, 10, 'a')

statement ok
INSERT INTO t VALUES (2, 20, 'b')

statement ok
INSERT INTO t VALUES (3, 30, 'c')

statement ok
INSERT INTO t VALUES (4, 40, 'd')

statement ok
INSERT INTO t VALUES (5, 50, 'e')

query I nosort
SELECT score FROM t WHERE id = 3
----
30

query I rowsort
SELECT score FROM t WHERE id <> 3
----
10
20
40
50

query I rowsort
SELECT score FROM t WHERE score > 25
----
30
40
50

query I rowsort
SELECT score FROM t WHERE score BETWEEN 20 AND 40
----
20
30
40

query I rowsort
SELECT score FROM t WHERE score < 20 OR score > 40
----
10
50

query T rowsort
SELECT name FROM t WHERE id = 2 AND score = 20
----
b
