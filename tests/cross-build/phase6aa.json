{
  "phase": "6aa",
  "description": "Phase 6aa gate — non-recursive CTEs (WITH name AS (...) outer-stmt). No new VDBE opcodes. max_invariant=43 unchanged. Algorithm per spec/sql-grammar.spec.md § 'Phase 6aa'. All prior phase fixtures must stay green.",
  "cases": [
    {
      "name": "cte-basic-select",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                                              "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1), (2), (3);",                                       "expect": {"rows": []}},
        {"sql": "WITH x AS (SELECT a FROM t) SELECT a FROM x ORDER BY a;",                  "expect": {"rows": [[1], [2], [3]]}}
      ]
    },
    {
      "name": "cte-with-where",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                                              "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1), (2), (3), (4), (5);",                             "expect": {"rows": []}},
        {"sql": "WITH evens AS (SELECT a FROM t WHERE a = 2 OR a = 4) SELECT a FROM evens ORDER BY a;", "expect": {"rows": [[2], [4]]}}
      ]
    },
    {
      "name": "cte-with-aggregate",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                                              "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1), (2), (3), (4);",                                   "expect": {"rows": []}},
        {"sql": "WITH agg AS (SELECT SUM(a) AS s FROM t) SELECT s FROM agg;",                "expect": {"rows": [[10]]}}
      ]
    },
    {
      "name": "cte-used-in-where-outer",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                                              "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1), (2), (3), (4);",                                   "expect": {"rows": []}},
        {"sql": "WITH mx AS (SELECT MAX(a) AS m FROM t) SELECT a FROM t WHERE a = (SELECT m FROM mx);", "expect": {"rows": [[4]]}}
      ]
    },
    {
      "name": "cte-multiple-bindings",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                                                           "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1), (2), (3);",                                                    "expect": {"rows": []}},
        {"sql": "WITH lo AS (SELECT MIN(a) AS m FROM t), hi AS (SELECT MAX(a) AS m FROM t) SELECT (SELECT m FROM lo), (SELECT m FROM hi);", "expect": {"rows": [[1, 3]]}}
      ]
    },
    {
      "name": "cte-in-join",
      "program": [
        {"sql": "CREATE TABLE users (id INTEGER, name TEXT);",                                           "expect": {"rows": []}},
        {"sql": "INSERT INTO users VALUES (1, 'alice'), (2, 'bob');",                                     "expect": {"rows": []}},
        {"sql": "WITH aliases AS (SELECT id, name FROM users) SELECT u.id, a.name FROM users u INNER JOIN aliases a ON u.id = a.id ORDER BY u.id;", "expect": {"rows": [[1, "alice"], [2, "bob"]]}}
      ]
    },
    {
      "name": "cte-referenced-twice",
      "description": "CTE referenced twice in outer statement — re-evaluated per reference in v1 (option-a substitution semantics).",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                                              "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1), (2);",                                            "expect": {"rows": []}},
        {"sql": "WITH x AS (SELECT a FROM t) SELECT x1.a, x2.a FROM x x1, x x2 ORDER BY x1.a, x2.a;", "expect": {"rows": [[1, 1], [1, 2], [2, 1], [2, 2]]}}
      ]
    },
    {
      "name": "cte-shadows-real-table",
      "description": "CTE name `t` shadows real table `t` for the outer statement's duration.",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                                              "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1), (2), (3);",                                       "expect": {"rows": []}},
        {"sql": "WITH t AS (SELECT 99 AS a) SELECT a FROM t;",                              "expect": {"rows": [[99]]}}
      ]
    },
    {
      "name": "cte-duplicate-name-rejected",
      "program": [
        {"sql": "WITH x AS (SELECT 1), x AS (SELECT 2) SELECT 1;", "expect": {"error": {"name": "PARSE_DUPLICATE_CTE_NAME"}}}
      ]
    },
    {
      "name": "cte-missing-as-rejected",
      "program": [
        {"sql": "WITH x (SELECT 1) SELECT 1;", "expect": {"error": {"name": "PARSE_UNEXPECTED_TOKEN"}}}
      ]
    },
    {
      "name": "cte-missing-outer-statement-rejected",
      "program": [
        {"sql": "WITH x AS (SELECT 1);", "expect": {"error": {"name": "PARSE_UNEXPECTED_TOKEN"}}}
      ]
    },
    {
      "name": "cte-trailing-comma-rejected",
      "program": [
        {"sql": "WITH x AS (SELECT 1), SELECT 1;", "expect": {"error": {"name": "PARSE_UNEXPECTED_TOKEN"}}}
      ]
    },
    {
      "name": "cte-with-insert-outer",
      "program": [
        {"sql": "CREATE TABLE src (a INTEGER);",                                              "expect": {"rows": []}},
        {"sql": "INSERT INTO src VALUES (1), (2), (3);",                                      "expect": {"rows": []}},
        {"sql": "CREATE TABLE dst (a INTEGER);",                                              "expect": {"rows": []}},
        {"sql": "WITH src_max AS (SELECT MAX(a) AS m FROM src) INSERT INTO dst VALUES ((SELECT m FROM src_max));", "expect": {"rows": []}},
        {"sql": "SELECT a FROM dst;",                                                          "expect": {"rows": [[3]]}}
      ]
    },
    {
      "name": "cte-with-delete-outer",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                                              "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1), (2), (3), (4);",                                   "expect": {"rows": []}},
        {"sql": "WITH threshold AS (SELECT 2 AS v) DELETE FROM t WHERE a <= (SELECT v FROM threshold);", "expect": {"rows": []}},
        {"sql": "SELECT a FROM t ORDER BY a;",                                                 "expect": {"rows": [[3], [4]]}}
      ]
    },
    {
      "name": "cte-with-update-outer",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER, b INTEGER);",                                                 "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1, 10), (2, 20), (3, 30);",                                         "expect": {"rows": []}},
        {"sql": "WITH bonus AS (SELECT 100 AS v) UPDATE t SET b = b + (SELECT v FROM bonus) WHERE a = 2;", "expect": {"rows": []}},
        {"sql": "SELECT a, b FROM t ORDER BY a;",                                                           "expect": {"rows": [[1, 10], [2, 120], [3, 30]]}}
      ]
    }
  ]
}
