# Smoke: UPDATE and DELETE (Phase 2c-3 + 9c).

statement ok
CREATE TABLE t (id INTEGER, val INTEGER)

statement ok
INSERT INTO t VALUES (1, 10)

statement ok
INSERT INTO t VALUES (2, 20)

statement ok
INSERT INTO t VALUES (3, 30)

statement ok
UPDATE t SET val = val * 2 WHERE id = 2

query II nosort
SELECT id, val FROM t ORDER BY id
----
1
10
2
40
3
30

statement ok
DELETE FROM t WHERE id = 1

query II nosort
SELECT id, val FROM t ORDER BY id
----
2
40
3
30

# DELETE without WHERE removes everything
statement ok
DELETE FROM t

query I nosort
SELECT COUNT(*) FROM t
----
0

# UPDATE with no matching row is a no-op (not an error)
statement ok
INSERT INTO t VALUES (99, 99)

statement ok
UPDATE t SET val = 0 WHERE id = 12345

query II nosort
SELECT id, val FROM t
----
99
99
