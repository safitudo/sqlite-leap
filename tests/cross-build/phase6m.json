{
  "phase": "6m",
  "description": "Phase 6m gate — compound SELECT with UNION ALL. Row concatenation, no dedup. Column count must match across cores. ORDER BY / LIMIT apply at compound level, resolve against first core's output schema. KEYWORD_UNION and KEYWORD_ALL are new reserved keywords. All phase1..6l fixtures must stay green.",
  "cases": [
    {
      "name": "union-all-two-literals",
      "program": [
        {"sql": "SELECT 1 UNION ALL SELECT 2;", "expect": {"rows": [[1], [2]]}}
      ]
    },
    {
      "name": "union-all-three-literals",
      "program": [
        {"sql": "SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3;", "expect": {"rows": [[1], [2], [3]]}}
      ]
    },
    {
      "name": "union-all-two-tables",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (3);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (4);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a UNION ALL SELECT x FROM b;",           "expect": {"rows": [[1], [2], [3], [4]]}}
      ]
    },
    {
      "name": "union-all-preserves-duplicates",
      "description": "UNION ALL does NOT deduplicate — UNION (without ALL) does; that's Phase 6o.",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a UNION ALL SELECT x FROM b;",           "expect": {"rows": [[1], [2], [1], [2]]}}
      ]
    },
    {
      "name": "union-all-multi-column",
      "program": [
        {"sql": "CREATE TABLE a (id INTEGER, name TEXT);",              "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (id INTEGER, name TEXT);",              "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1, 'alice');",                   "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (2, 'bob');",                     "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (3, 'carol');",                   "expect": {"rows": []}},
        {"sql": "SELECT id, name FROM a UNION ALL SELECT id, name FROM b;", "expect": {"rows": [[1, "alice"], [2, "bob"], [3, "carol"]]}}
      ]
    },
    {
      "name": "union-all-with-where",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (4);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM t WHERE x < 2 UNION ALL SELECT x FROM t WHERE x > 3;", "expect": {"rows": [[1], [4]]}}
      ]
    },
    {
      "name": "union-all-with-order-by",
      "description": "ORDER BY applies to combined result.",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (3);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (4);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a UNION ALL SELECT x FROM b ORDER BY x;", "expect": {"rows": [[1], [2], [3], [4]]}}
      ]
    },
    {
      "name": "union-all-with-order-by-desc",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a UNION ALL SELECT x FROM b ORDER BY x DESC;", "expect": {"rows": [[2], [1]]}}
      ]
    },
    {
      "name": "union-all-with-limit",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (3);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (4);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a UNION ALL SELECT x FROM b LIMIT 3;",   "expect": {"rows": [[1], [2], [3]]}}
      ]
    },
    {
      "name": "union-all-with-order-by-and-limit",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (5);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (3);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (4);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a UNION ALL SELECT x FROM b ORDER BY x LIMIT 2;", "expect": {"rows": [[1], [3]]}}
      ]
    },
    {
      "name": "union-all-arity-mismatch",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER, y INTEGER);",               "expect": {"rows": []}},
        {"sql": "SELECT x FROM a UNION ALL SELECT x, y FROM b;",        "expect": {"error": {"name": "COMPILE_COMPOUND_ARITY_MISMATCH", "fields": {"expected": 1, "got": 2, "at_core": 2}}}}
      ]
    },
    {
      "name": "union-all-arity-mismatch-three-cores",
      "description": "Third core mismatches — error reports at_core=3.",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER, y INTEGER);",               "expect": {"rows": []}},
        {"sql": "SELECT x, y FROM t UNION ALL SELECT x, y FROM t UNION ALL SELECT x FROM t;", "expect": {"error": {"name": "COMPILE_COMPOUND_ARITY_MISMATCH", "fields": {"expected": 2, "got": 1, "at_core": 3}}}}
      ]
    },
    {
      "name": "union-all-with-aggregate",
      "description": "Each core may have its own aggregate.",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (10);",                           "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (20);",                           "expect": {"rows": []}},
        {"sql": "SELECT SUM(x) FROM a UNION ALL SELECT SUM(x) FROM b;", "expect": {"rows": [[3], [30]]}}
      ]
    },
    {
      "name": "union-all-first-core-column-names-used",
      "description": "ORDER BY resolves against first core's output names. Second core's names are ignored.",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (y INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (3);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a UNION ALL SELECT y FROM b ORDER BY x;", "expect": {"rows": [[1], [2], [3]]}}
      ]
    },
    {
      "name": "union-all-keyword-union-reserved",
      "program": [
        {"sql": "CREATE TABLE t (union INTEGER);", "expect": {"error": {"name": "PARSE_UNEXPECTED_TOKEN", "fields": {"kind": "KEYWORD_UNION"}}}}
      ]
    },
    {
      "name": "union-all-keyword-all-reserved",
      "program": [
        {"sql": "CREATE TABLE t (all INTEGER);", "expect": {"error": {"name": "PARSE_UNEXPECTED_TOKEN", "fields": {"kind": "KEYWORD_ALL"}}}}
      ]
    },
    {
      "name": "union-all-empty-left-core",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a UNION ALL SELECT x FROM b;",           "expect": {"rows": [[1], [2]]}}
      ]
    },
    {
      "name": "union-all-empty-right-core",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a UNION ALL SELECT x FROM b;",           "expect": {"rows": [[1]]}}
      ]
    },
    {
      "name": "union-all-both-empty",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "SELECT x FROM a UNION ALL SELECT x FROM b;",           "expect": {"rows": []}}
      ]
    },
    {
      "name": "union-all-mixed-types",
      "description": "Cross-type total order for ORDER BY: NULL < numeric < Text.",
      "program": [
        {"sql": "CREATE TABLE a (v INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (v TEXT);",                             "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (5);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES ('z');",                          "expect": {"rows": []}},
        {"sql": "SELECT v FROM a UNION ALL SELECT v FROM b ORDER BY v;", "expect": {"rows": [[5], ["z"]]}}
      ]
    },
    {
      "name": "union-all-three-cores-ordered",
      "program": [
        {"sql": "SELECT 3 UNION ALL SELECT 1 UNION ALL SELECT 2 ORDER BY 1;", "expect": {"rows": [[1], [2], [3]]}}
      ]
    },
    {
      "name": "union-all-order-by-position",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER, y INTEGER);",               "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER, y INTEGER);",               "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (2, 20);",                        "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1, 10);",                        "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (4, 40);",                        "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (3, 30);",                        "expect": {"rows": []}},
        {"sql": "SELECT x, y FROM a UNION ALL SELECT x, y FROM b ORDER BY 1;", "expect": {"rows": [[1, 10], [2, 20], [3, 30], [4, 40]]}}
      ]
    },
    {
      "name": "union-all-limit-zero",
      "program": [
        {"sql": "SELECT 1 UNION ALL SELECT 2 LIMIT 0;", "expect": {"rows": []}}
      ]
    },
    {
      "name": "union-all-limit-offset",
      "program": [
        {"sql": "SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 LIMIT 2 OFFSET 1;", "expect": {"rows": [[2], [3]]}}
      ]
    },
    {
      "name": "union-all-with-cast",
      "description": "Composing 6i CAST into compound SELECT.",
      "program": [
        {"sql": "SELECT CAST(1 AS REAL) UNION ALL SELECT CAST(2 AS REAL);", "expect": {"rows": [[1.0], [2.0]]}}
      ]
    },
    {
      "name": "union-all-with-scalar-func",
      "description": "Composing 6j LENGTH into compound SELECT.",
      "program": [
        {"sql": "SELECT LENGTH('a') UNION ALL SELECT LENGTH('bb') UNION ALL SELECT LENGTH('ccc');", "expect": {"rows": [[1], [2], [3]]}}
      ]
    }
  ]
}
