# =============================================================
# Section 13: features beyond v1 steel-thread (expected DEFER)
# These records are kept so the matrix surfaces the boundary of
# the implemented compile path. A DEFER on every target is the
# documented expected outcome here, not a regression.
# =============================================================

query I nosort
SELECT t.id FROM nums AS t INNER JOIN nums AS u ON t.id = u.id
----
1
2
3
4
5

query I nosort
WITH cte AS (SELECT id FROM nums WHERE id > 2) SELECT id FROM cte
----
3
4
5

query I nosort
SELECT id FROM nums WHERE id IN (SELECT id FROM nums WHERE id > 3)
----
4
5

query I nosort
SELECT id FROM nums WHERE EXISTS (SELECT 1 FROM nums AS u WHERE u.id = nums.id)
----
1
2
3
4
5

query I nosort
SELECT (SELECT MAX(val) FROM nums)
----
50

