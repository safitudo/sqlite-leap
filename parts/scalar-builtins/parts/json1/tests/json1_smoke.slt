# JSON1 scalar function smoke — language-neutral SLT.
#
# Covers the json_* surface implemented by parts/scalar-builtins/parts/json1
# (json, json_array, json_object, json_extract, json_type, json_valid,
# json_array_length, json_insert, json_replace, json_set, json_remove,
# json_patch). Reference surface: sqlite.org/json1.html (spec only).
#
# All values rendered per slt_runner: Integer for I, %.3f for R,
# direct text for T (non-printable -> '@', empty -> "(empty)", NULL -> "NULL").

# ---- json() canonicalization ----

query T nosort
SELECT json('{"b":2,"a":1}')
----
{"b":2,"a":1}

query T nosort
SELECT json('  [1,  2 ,3 ] ')
----
[1,2,3]

query T nosort
SELECT json('null')
----
null

query T nosort
SELECT json('"hi"')
----
"hi"

query T nosort
SELECT json('42')
----
42

query T nosort
SELECT json('3.5')
----
3.5

# ---- json_array() ----

query T nosort
SELECT json_array(1, 2, 3)
----
[1,2,3]

query T nosort
SELECT json_array()
----
[]

query T nosort
SELECT json_array('hi', 7)
----
["hi",7]

# Embedded JSON: text starting with '{' or '[' is parsed (pin 8/17).
query T nosort
SELECT json_array(json_object('a', 1))
----
[{"a":1}]

# ---- json_object() ----

query T nosort
SELECT json_object('a', 1, 'b', 'x')
----
{"a":1,"b":"x"}

query T nosort
SELECT json_object()
----
{}

query T nosort
SELECT json_object('n', NULL)
----
{"n":null}

# ---- json_extract() ----

query I nosort
SELECT json_extract('{"a":42}', '$.a')
----
42

query I nosort
SELECT json_extract('{"a":{"b":42}}', '$.a.b')
----
42

query I nosort
SELECT json_extract('{"a":[10,20,30]}', '$.a[1]')
----
20

query I nosort
SELECT json_extract('[10,20,30]', '$[2]')
----
30

query T nosort
SELECT json_extract('{"a":{"b":42}}', '$.a')
----
{"b":42}

query T nosort
SELECT json_extract('{"a":1}', '$.missing')
----
NULL

query T nosort
SELECT json_extract('[1,2,3]', '$[0]', '$[2]')
----
[1,3]

# Negative-index path lookups
query I nosort
SELECT json_extract('[10,20,30]', '$[-1]')
----
30

# ---- json_type() ----

query T nosort
SELECT json_type('null')
----
null

query T nosort
SELECT json_type('true')
----
true

query T nosort
SELECT json_type('false')
----
false

query T nosort
SELECT json_type('42')
----
integer

query T nosort
SELECT json_type('3.14')
----
real

query T nosort
SELECT json_type('"hello"')
----
text

query T nosort
SELECT json_type('[1,2]')
----
array

query T nosort
SELECT json_type('{"a":1}')
----
object

query T nosort
SELECT json_type('{"a":[1,2]}', '$.a')
----
array

# ---- json_valid() ----

query I nosort
SELECT json_valid('{"a":1}')
----
1

query I nosort
SELECT json_valid('null')
----
1

query I nosort
SELECT json_valid('[1,2,3]')
----
1

query I nosort
SELECT json_valid('not json')
----
0

query I nosort
SELECT json_valid('{a:1}')
----
0

query I nosort
SELECT json_valid('')
----
0

query I nosort
SELECT json_valid(NULL)
----
0

# ---- json_array_length() ----

query I nosort
SELECT json_array_length('[1,2,3]')
----
3

query I nosort
SELECT json_array_length('[]')
----
0

query I nosort
SELECT json_array_length('{"a":1}')
----
0

query I nosort
SELECT json_array_length('[1,2,3,4]', '$')
----
4

query I nosort
SELECT json_array_length('{"a":[10,20,30]}', '$.a')
----
3

# ---- json_insert / json_replace / json_set ----

# insert: only if absent
query T nosort
SELECT json_insert('{"a":1}', '$.b', 2)
----
{"a":1,"b":2}

# insert is a no-op when the path exists
query T nosort
SELECT json_insert('{"a":1}', '$.a', 99)
----
{"a":1}

# replace: only if present
query T nosort
SELECT json_replace('{"a":1}', '$.a', 99)
----
{"a":99}

# replace is a no-op when path absent
query T nosort
SELECT json_replace('{"a":1}', '$.b', 2)
----
{"a":1}

# set: insert or replace
query T nosort
SELECT json_set('{"a":1}', '$.a', 99, '$.b', 2)
----
{"a":99,"b":2}

# ---- json_remove ----

query T nosort
SELECT json_remove('{"a":1,"b":2}', '$.a')
----
{"b":2}

query T nosort
SELECT json_remove('[10,20,30]', '$[1]')
----
[10,30]

# ---- json_patch (RFC 7396) ----

query T nosort
SELECT json_patch('{"a":1,"b":2}', '{"b":null,"c":3}')
----
{"a":1,"c":3}

query T nosort
SELECT json_patch('{"a":1}', '{"a":{"x":10}}')
----
{"a":{"x":10}}

# ---- error / edge cases ----

# Malformed JSON inputs collapse to NULL at the dispatch boundary (pin 20)
query T nosort
SELECT json('not json')
----
NULL

query T nosort
SELECT json_extract('not json', '$.a')
----
NULL

# json_extract on JSON null leaf returns SQL NULL
query T nosort
SELECT json_extract('{"a":null}', '$.a')
----
NULL

# json_object odd-arity → NULL
query T nosort
SELECT json_object('a')
----
NULL
