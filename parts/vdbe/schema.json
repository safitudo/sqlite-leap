{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "VDBE part API",
  "description": "Abstract API of the vdbe part. Each language target maps this to idiomatic syntax.",
  "part": "vdbe",
  "entry": {
    "name": "run",
    "inputs": [
      {"name": "program",        "ref":  "../../schema/program.schema.json"},
      {"name": "storage_handle", "type": "handle", "description": "opaque mutable Database handle"}
    ],
    "outputs": {
      "success": {"ref": "../../schema/result.schema.json"},
      "errors": [
        {"name": "STORAGE_TABLE_EXISTS",     "fields": {"table": {"type": "string"}}},
        {"name": "STORAGE_TABLE_NOT_FOUND",  "fields": {"table": {"type": "string"}}},
        {"name": "STORAGE_COLUMN_NOT_FOUND", "fields": {"table": {"type": "string"}, "column": {"type": "string"}}},
        {"name": "STORAGE_DUPLICATE_COLUMN", "fields": {"table": {"type": "string"}, "column": {"type": "string"}}},
        {"name": "STORAGE_ARITY_MISMATCH",   "fields": {"table": {"type": "string"}, "expected": {"type": "integer"}, "got": {"type": "integer"}}},
        {"name": "STORAGE_TYPE_MISMATCH",    "fields": {"table": {"type": "string"}, "column": {"type": "string"}, "expected_type": {"enum": ["INTEGER", "TEXT"]}, "got_type": {"enum": ["INTEGER", "TEXT"]}}},
        {"name": "EVAL_DIVISION_BY_ZERO",    "fields": {}},
        {"name": "EVAL_TYPE_ERROR",          "fields": {
          "op": {"type": "string"},
          "left_type":    {"type": "string", "enum": ["INTEGER", "TEXT", "NULL"], "description": "present for binary ops"},
          "right_type":   {"type": "string", "enum": ["INTEGER", "TEXT", "NULL"], "description": "present for binary ops"},
          "operand_type": {"type": "string", "enum": ["INTEGER", "TEXT", "NULL"], "description": "present for unary ops"}
        }, "note": "For binary ops (Add/Subtract/Multiply/Divide/Eq/Ne/Lt/Le/Gt/Ge/And/Or), left_type + right_type are present. For unary ops (Negate/Not/WHERE-gate), operand_type is present. The harness comparator must tolerate which subset is present based on op. Valid op values: arithmetic '+', '-', '*', '/'; unary '-' (Negate); comparisons '=', '!=', '<', '<=', '>', '>='; logical 'AND', 'OR', 'NOT'; WHERE-gate 'WHERE'."}
      ]
    }
  }
}
