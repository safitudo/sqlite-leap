{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Parser part API",
  "description": "Abstract API of the parser part. Each language target maps this to idiomatic syntax.",
  "part": "parser",
  "entry": {
    "name": "parse",
    "input": {
      "name": "tokens",
      "type": "array",
      "itemsRef": "../../schema/tokens.schema.json"
    },
    "outputs": {
      "success": {
        "ref": "../../schema/ast.schema.json"
      },
      "errors": [
        {
          "name": "PARSE_UNEXPECTED_TOKEN",
          "fields": {
            "kind": {
              "type": "string",
              "enum": [
                "KEYWORD_SELECT", "KEYWORD_NULL", "KEYWORD_CREATE", "KEYWORD_TABLE",
                "KEYWORD_INSERT", "KEYWORD_INTO", "KEYWORD_VALUES", "KEYWORD_FROM",
                "KEYWORD_INTEGER", "KEYWORD_TEXT",
                "IDENTIFIER", "INTEGER_LITERAL", "STRING_LITERAL",
                "LPAREN", "RPAREN", "COMMA", "STAR", "SEMICOLON", "EOF"
              ]
            },
            "pos": {"type": "integer", "minimum": 0},
            "expected": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "KEYWORD_SELECT", "KEYWORD_NULL", "KEYWORD_CREATE", "KEYWORD_TABLE",
                  "KEYWORD_INSERT", "KEYWORD_INTO", "KEYWORD_VALUES", "KEYWORD_FROM",
                  "KEYWORD_INTEGER", "KEYWORD_TEXT",
                  "IDENTIFIER", "INTEGER_LITERAL", "STRING_LITERAL",
                  "LPAREN", "RPAREN", "COMMA", "STAR", "SEMICOLON", "EOF"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
