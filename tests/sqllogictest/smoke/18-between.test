# Smoke: BETWEEN operator (Phase 9d).

statement ok
CREATE TABLE t (a INTEGER)

statement ok
INSERT INTO t VALUES (1)

statement ok
INSERT INTO t VALUES (2)

statement ok
INSERT INTO t VALUES (3)

statement ok
INSERT INTO t VALUES (4)

statement ok
INSERT INTO t VALUES (5)

query I rowsort
SELECT a FROM t WHERE a BETWEEN 2 AND 4
----
2
3
4

# BETWEEN is inclusive on both ends
query I rowsort
SELECT a FROM t WHERE a BETWEEN 3 AND 3
----
3

# Empty range
query I rowsort
SELECT a FROM t WHERE a BETWEEN 10 AND 20
----

# Text comparison
statement ok
