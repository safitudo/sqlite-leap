{
  "phase": "6v",
  "description": "Phase 6v gate — IN (expr-list) and NOT IN (expr-list) predicates. No new VDBE opcodes; max_invariant=42 unchanged. Algorithm per spec/sql-grammar.spec.md § 'Phase 6v'. All prior phase fixtures must stay green. Byte-identical cross-build on result rows.",
  "cases": [
    {
      "name": "in-list-literal-match",
      "program": [
        {"sql": "SELECT 2 IN (1, 2, 3);", "expect": {"rows": [[1]]}}
      ]
    },
    {
      "name": "in-list-literal-no-match",
      "program": [
        {"sql": "SELECT 5 IN (1, 2, 3);", "expect": {"rows": [[0]]}}
      ]
    },
    {
      "name": "in-single-element-match",
      "program": [
        {"sql": "SELECT 42 IN (42);", "expect": {"rows": [[1]]}}
      ]
    },
    {
      "name": "in-single-element-no-match",
      "program": [
        {"sql": "SELECT 42 IN (99);", "expect": {"rows": [[0]]}}
      ]
    },
    {
      "name": "not-in-list-match",
      "program": [
        {"sql": "SELECT 5 NOT IN (1, 2, 3);", "expect": {"rows": [[1]]}}
      ]
    },
    {
      "name": "not-in-list-no-match",
      "program": [
        {"sql": "SELECT 2 NOT IN (1, 2, 3);", "expect": {"rows": [[0]]}}
      ]
    },
    {
      "name": "in-list-text",
      "program": [
        {"sql": "SELECT 'b' IN ('a', 'b', 'c');", "expect": {"rows": [[1]]}}
      ]
    },
    {
      "name": "in-list-mixed-types-no-coercion",
      "description": "1 vs '1' do not compare equal (different types). Matches existing cross-type = semantics.",
      "program": [
        {"sql": "SELECT 1 IN ('1', '2');", "expect": {"rows": [[0]]}}
      ]
    },
    {
      "name": "in-list-null-lhs-yields-null",
      "description": "x = Null yields Null; OR of Nulls is Null. So `NULL IN (1,2)` is Null. Column-rendering: Null is rendered as NULL; sqllogictest-style column type T tolerates it.",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                       "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (NULL);",                      "expect": {"rows": []}},
        {"sql": "SELECT COUNT(*) FROM t WHERE a IN (1, 2);",          "expect": {"rows": [[0]]}}
      ]
    },
    {
      "name": "in-list-null-rhs-when-no-match-yields-null",
      "description": "`x IN (y, NULL)` where x != y and x != NULL is UNKNOWN per SQL 3VL. WHERE filters it out.",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (5);",                               "expect": {"rows": []}},
        {"sql": "SELECT COUNT(*) FROM t WHERE a IN (1, NULL);",            "expect": {"rows": [[0]]}}
      ]
    },
    {
      "name": "in-list-null-rhs-with-match-yields-one",
      "description": "`x IN (y, NULL)` where x = y short-circuits to TRUE; Null element is irrelevant.",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (5);",                               "expect": {"rows": []}},
        {"sql": "SELECT COUNT(*) FROM t WHERE a IN (5, NULL);",            "expect": {"rows": [[1]]}}
      ]
    },
    {
      "name": "in-list-on-column",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",                               "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",                               "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",                               "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (4);",                               "expect": {"rows": []}},
        {"sql": "SELECT a FROM t WHERE a IN (2, 4) ORDER BY a;",           "expect": {"rows": [[2], [4]]}}
      ]
    },
    {
      "name": "not-in-list-on-column",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",                               "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",                               "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",                               "expect": {"rows": []}},
        {"sql": "SELECT a FROM t WHERE a NOT IN (2) ORDER BY a;",          "expect": {"rows": [[1], [3]]}}
      ]
    },
    {
      "name": "in-list-with-expressions",
      "description": "List elements may be arbitrary expressions, not just literals.",
      "program": [
        {"sql": "SELECT 5 IN (1 + 1, 2 * 3 - 1, 10);", "expect": {"rows": [[1]]}}
      ]
    },
    {
      "name": "in-list-empty-parens-accepted",
      "description": "Phase 6bc supersedes the earlier 6v rejection: empty IN () is a constant 0 (Null if LHS is Null).",
      "program": [
        {"sql": "SELECT 1 IN ();", "expect": {"rows": [[0]]}}
      ]
    },
    {
      "name": "in-list-combined-with-and",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER, b TEXT);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1, 'x');",                                  "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2, 'y');",                                  "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3, 'x');",                                  "expect": {"rows": []}},
        {"sql": "SELECT a FROM t WHERE a IN (1, 3) AND b = 'x' ORDER BY a;",       "expect": {"rows": [[1], [3]]}}
      ]
    }
  ]
}
