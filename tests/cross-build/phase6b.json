{
  "phase": "6b",
  "description": "Phase 6b gate — ORDER BY clause on SELECT FROM. Single- and multi-column sort, ASC/DESC direction (default ASC), interaction with WHERE / LIMIT / OFFSET, NULL ordering (NULL < non-NULL), mixed INTEGER/TEXT type ordering (NULL < INTEGER < TEXT), stable sort preservation. Parse-error cases for malformed ORDER BY. In-memory backend only. All phase1..6a fixtures must stay green.",
  "cases": [
    {
      "name": "orderby-asc-basic",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",           "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",             "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",             "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",             "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER BY x;",           "expect": {"rows": [[1], [2], [3]]}}
      ]
    },
    {
      "name": "orderby-desc-basic",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",           "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",             "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",             "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",             "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER BY x DESC;",      "expect": {"rows": [[3], [2], [1]]}}
      ]
    },
    {
      "name": "orderby-asc-explicit",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",           "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",             "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",             "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER BY x ASC;",       "expect": {"rows": [[1], [2]]}}
      ]
    },
    {
      "name": "orderby-multi-column",
      "description": "Lexicographic sort by (a ASC, b ASC): first key primary, second tiebreaker.",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER, b INTEGER);", "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1, 20);",          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2, 10);",          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1, 10);",          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2, 20);",          "expect": {"rows": []}},
        {"sql": "SELECT a, b FROM t ORDER BY a, b;",      "expect": {"rows": [[1, 10], [1, 20], [2, 10], [2, 20]]}}
      ]
    },
    {
      "name": "orderby-multi-mixed-directions",
      "description": "ORDER BY a ASC, b DESC — primary ASC, tiebreaker DESC.",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER, b INTEGER);",   "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1, 20);",            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1, 10);",            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2, 10);",            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2, 20);",            "expect": {"rows": []}},
        {"sql": "SELECT a, b FROM t ORDER BY a ASC, b DESC;", "expect": {"rows": [[1, 20], [1, 10], [2, 20], [2, 10]]}}
      ]
    },
    {
      "name": "orderby-nulls-asc-first",
      "description": "NULLs sort first for ASC (less than any non-NULL).",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",              "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (NULL);",           "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",              "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (NULL);",           "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER BY x;",            "expect": {"rows": [[null], [null], [1], [3]]}}
      ]
    },
    {
      "name": "orderby-nulls-desc-last",
      "description": "NULLs sort last for DESC (still less than any non-NULL, so DESC puts them at the end).",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",              "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (NULL);",           "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",              "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER BY x DESC;",       "expect": {"rows": [[3], [1], [null]]}}
      ]
    },
    {
      "name": "orderby-text",
      "description": "TEXT sort is byte-lexicographic.",
      "program": [
        {"sql": "CREATE TABLE t (s TEXT);",                "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES ('charlie');",       "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES ('alpha');",         "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES ('bravo');",         "expect": {"rows": []}},
        {"sql": "SELECT s FROM t ORDER BY s;",             "expect": {"rows": [["alpha"], ["bravo"], ["charlie"]]}}
      ]
    },
    {
      "name": "orderby-with-where",
      "description": "WHERE filters first, ORDER BY sorts the filtered rows.",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",                "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",                  "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",                  "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",                  "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (4);",                  "expect": {"rows": []}},
        {"sql": "SELECT x FROM t WHERE x > 1 ORDER BY x DESC;", "expect": {"rows": [[4], [3], [2]]}}
      ]
    },
    {
      "name": "orderby-with-limit",
      "description": "LIMIT applies AFTER ORDER BY — top-N semantics.",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",                  "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",                    "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",                    "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (5);",                    "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",                    "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (4);",                    "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER BY x DESC LIMIT 2;",     "expect": {"rows": [[5], [4]]}}
      ]
    },
    {
      "name": "orderby-with-limit-offset",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (5);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (4);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER BY x ASC LIMIT 2 OFFSET 1;",     "expect": {"rows": [[2], [3]]}}
      ]
    },
    {
      "name": "orderby-star-projection",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER, b TEXT);",    "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3, 'c');",         "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1, 'a');",         "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2, 'b');",         "expect": {"rows": []}},
        {"sql": "SELECT * FROM t ORDER BY a;",            "expect": {"rows": [[1, "a"], [2, "b"], [3, "c"]]}}
      ]
    },
    {
      "name": "orderby-by-non-projected-column",
      "description": "ORDER BY can sort by a column that isn't in the projection.",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER, b INTEGER);",   "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (10, 3);",            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (20, 1);",            "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (30, 2);",            "expect": {"rows": []}},
        {"sql": "SELECT a FROM t ORDER BY b;",              "expect": {"rows": [[20], [30], [10]]}}
      ]
    },
    {
      "name": "orderby-stable",
      "description": "Stable sort: rows equal on all keys keep insertion order.",
      "program": [
        {"sql": "CREATE TABLE t (a INTEGER, tag INTEGER);", "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1, 100);",           "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1, 200);",           "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1, 300);",           "expect": {"rows": []}},
        {"sql": "SELECT tag FROM t ORDER BY a;",            "expect": {"rows": [[100], [200], [300]]}}
      ]
    },
    {
      "name": "orderby-expression",
      "description": "ORDER BY may be an expression, not just a bare column.",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",              "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",                "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",                "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",                "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER BY 0 - x;",          "expect": {"rows": [[3], [2], [1]]}}
      ]
    },
    {
      "name": "orderby-empty-table",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",              "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER BY x;",              "expect": {"rows": []}}
      ]
    },
    {
      "name": "orderby-mixed-types",
      "description": "NULL < INTEGER < TEXT when sorting mixed-type values in same column (TEXT column accepts INTEGER and TEXT and NULL values in our type system).",
      "program": [
        {"sql": "CREATE TABLE t (x TEXT);",                 "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES ('hello');",          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (NULL);",             "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES ('apple');",          "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER BY x;",              "expect": {"rows": [[null], ["apple"], ["hello"]]}}
      ]
    },
    {
      "name": "parse-error-order-without-by",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",              "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER x;",                 "expect": {"error": {"name": "PARSE_UNEXPECTED_TOKEN", "fields": {"kind": "IDENTIFIER", "expected": ["KEYWORD_BY"]}}}}
      ]
    },
    {
      "name": "parse-error-order-by-empty",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",              "expect": {"rows": []}},
        {"sql": "SELECT x FROM t ORDER BY;",                "expect": {"error": {"name": "PARSE_UNEXPECTED_TOKEN", "fields": {"kind": "SEMICOLON"}}}}
      ]
    },
    {
      "name": "order-as-identifier-no-longer-works",
      "description": "Reserving ORDER as a keyword means it cannot be used as a column name.",
      "program": [
        {"sql": "CREATE TABLE t (order INTEGER);",          "expect": {"error": {"name": "PARSE_UNEXPECTED_TOKEN", "fields": {"kind": "KEYWORD_ORDER"}}}}
      ]
    },
    {
      "name": "by-as-identifier-no-longer-works",
      "program": [
        {"sql": "CREATE TABLE t (by INTEGER);",             "expect": {"error": {"name": "PARSE_UNEXPECTED_TOKEN", "fields": {"kind": "KEYWORD_BY"}}}}
      ]
    },
    {
      "name": "asc-as-identifier-no-longer-works",
      "program": [
        {"sql": "CREATE TABLE t (asc INTEGER);",            "expect": {"error": {"name": "PARSE_UNEXPECTED_TOKEN", "fields": {"kind": "KEYWORD_ASC"}}}}
      ]
    },
    {
      "name": "desc-as-identifier-no-longer-works",
      "program": [
        {"sql": "CREATE TABLE t (desc INTEGER);",           "expect": {"error": {"name": "PARSE_UNEXPECTED_TOKEN", "fields": {"kind": "KEYWORD_DESC"}}}}
      ]
    }
  ]
}
