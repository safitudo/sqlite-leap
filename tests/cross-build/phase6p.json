        {"sql": "INSERT INTO t VALUES (3);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM t INTERSECT SELECT x FROM t ORDER BY x;", "expect": {"rows": [[1], [2], [3]]}}
      ]
    },
    {
      "name": "intersect-multi-column",
      "program": [
