# 5-target canonical sqllogictest fixture.
#
# Small subset (CREATE / INSERT / SELECT only — DML round-trip not
# strictly required for the matrix). Every record has a single SQL
# statement on the next line. Multi-line SQL is intentionally avoided
# to keep the per-target drivers minimal.
#
# Format: a thin subset of the runner spec —
#   * `statement ok` — SQL must execute without error
#   * `query I nosort` / `query IT nosort` — SQL must execute and emit
#     the listed rows in the order shown.
# Blank lines separate records. Lines starting with `#` are comments.

statement ok
CREATE TABLE t (id INTEGER, name TEXT)

statement ok
INSERT INTO t VALUES (1, 'alice')

statement ok
INSERT INTO t VALUES (2, 'bob')

statement ok
INSERT INTO t VALUES (3, 'carol')

query I nosort
SELECT 1 + 2
----
3

query IT nosort
SELECT id, name FROM t
----
1
alice
2
bob
3
carol

query IT nosort
SELECT id, name FROM t WHERE id = 2
----
2
bob

query I nosort
SELECT id FROM t
----
1
2
3

query T nosort
SELECT name FROM t
----
alice
bob
carol

# Probe: this query type may exceed the steel-thread compile path on
# some targets. Drivers should report DEFER (not FAIL) when the
# parser/compiler refuses; otherwise PASS if the engine handles it.
query I nosort
SELECT COUNT(*) FROM t
----
3
