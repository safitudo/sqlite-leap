# Foreign-key constraint matrix smoke.
# Specifies behavior for ON DELETE / ON UPDATE actions across the
# CASCADE / SET NULL / SET DEFAULT / RESTRICT / NO ACTION matrix,
# multi-column FKs, cycle detection, and PRAGMA foreign_keys=OFF.
#
# Language-neutral; targets Rust + C + Zig + Go + Python via slt_runner.
# Pin references map to parts/storage/parts/foreign-keys/master.md (1-8, 10-13, 18).

# ----- Pin 1: PRAGMA foreign_keys defaults OFF; toggle ON --------------
statement ok
PRAGMA foreign_keys = ON

# ----- ON DELETE CASCADE (pin 6) ---------------------------------------
statement ok
CREATE TABLE p1 (id INTEGER PRIMARY KEY, name TEXT)

statement ok
CREATE TABLE c1 (cid INTEGER PRIMARY KEY, pid INTEGER REFERENCES p1(id) ON DELETE CASCADE)

statement ok
INSERT INTO p1 VALUES (1, 'p1a')

statement ok
INSERT INTO p1 VALUES (2, 'p1b')

statement ok
INSERT INTO c1 VALUES (10, 1)

statement ok
INSERT INTO c1 VALUES (11, 1)

statement ok
INSERT INTO c1 VALUES (12, 2)

statement ok
DELETE FROM p1 WHERE id = 1

# Children of pid=1 should have been cascade-deleted; pid=2 child remains.
query II rowsort
SELECT cid, pid FROM c1
----
12
2

# ----- ON DELETE SET NULL (pin 7) --------------------------------------
statement ok
CREATE TABLE p2 (id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE c2 (cid INTEGER PRIMARY KEY, pid INTEGER REFERENCES p2(id) ON DELETE SET NULL)

statement ok
INSERT INTO p2 VALUES (1)

statement ok
INSERT INTO c2 VALUES (20, 1)

statement ok
DELETE FROM p2 WHERE id = 1

query II rowsort
SELECT cid, pid FROM c2
----
20
NULL

# ----- ON DELETE SET DEFAULT (pin 7) -----------------------------------
statement ok
CREATE TABLE p3 (id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE c3 (cid INTEGER PRIMARY KEY, pid INTEGER DEFAULT 99 REFERENCES p3(id) ON DELETE SET DEFAULT)

statement ok
INSERT INTO p3 VALUES (1)

statement ok
INSERT INTO p3 VALUES (99)

statement ok
INSERT INTO c3 VALUES (30, 1)

statement ok
DELETE FROM p3 WHERE id = 1

# child.pid becomes column DEFAULT (99); parent row 99 keeps the FK valid.
query II rowsort
SELECT cid, pid FROM c3
----
30
99

# ----- ON DELETE RESTRICT (pin 4) --------------------------------------
statement ok
CREATE TABLE p4 (id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE c4 (cid INTEGER PRIMARY KEY, pid INTEGER REFERENCES p4(id) ON DELETE RESTRICT)

statement ok
INSERT INTO p4 VALUES (1)

statement ok
INSERT INTO c4 VALUES (40, 1)

# DELETE parent must fail while child rows exist.
statement error
DELETE FROM p4 WHERE id = 1

# Parent + child still present.
query I rowsort
SELECT id FROM p4
----
1

query II rowsort
SELECT cid, pid FROM c4
----
40
1

# Deleting child first then parent succeeds.
statement ok
DELETE FROM c4 WHERE cid = 40

statement ok
DELETE FROM p4 WHERE id = 1

# ----- ON UPDATE CASCADE (pin 6) ---------------------------------------
statement ok
CREATE TABLE p5 (id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE c5 (cid INTEGER PRIMARY KEY, pid INTEGER REFERENCES p5(id) ON UPDATE CASCADE)

statement ok
INSERT INTO p5 VALUES (1)

statement ok
INSERT INTO c5 VALUES (50, 1)

statement ok
INSERT INTO c5 VALUES (51, 1)

statement ok
UPDATE p5 SET id = 100 WHERE id = 1

# Both child rows should now reference 100.
query II rowsort
SELECT cid, pid FROM c5
----
50
100
51
100

# ----- Multi-column FK (pin 3 — arity, pin 6 — cascade) -----------------
statement ok
CREATE TABLE p6 (a INTEGER, b INTEGER, PRIMARY KEY(a, b))

statement ok
CREATE TABLE c6 (cid INTEGER PRIMARY KEY, fa INTEGER, fb INTEGER, FOREIGN KEY(fa, fb) REFERENCES p6(a, b) ON DELETE CASCADE)

statement ok
INSERT INTO p6 VALUES (1, 10)

statement ok
INSERT INTO p6 VALUES (2, 20)

statement ok
INSERT INTO c6 VALUES (60, 1, 10)

statement ok
INSERT INTO c6 VALUES (61, 2, 20)

statement ok
DELETE FROM p6 WHERE a = 1 AND b = 10

# Only (61, 2, 20) survives — multi-column key uniquely identifies parent.
query III rowsort
SELECT cid, fa, fb FROM c6
----
61
2
20

# ----- Cycle detection (pin 11): two tables refer to each other --------
# T1.x references T2.x and T2.y references T1.y. Deleting from either
# end must terminate (visited-set caps the recursion).
statement ok
CREATE TABLE t1 (y INTEGER PRIMARY KEY, x INTEGER)

statement ok
CREATE TABLE t2 (x INTEGER PRIMARY KEY, y INTEGER REFERENCES t1(y) ON DELETE CASCADE)

# Now extend t1.x to reference t2.x. We can't add the FK after-the-fact
# without ALTER TABLE; instead use a single-table self-reference for the
# cycle smoke (an even harder case for visited-set termination).
statement ok
CREATE TABLE selfref (id INTEGER PRIMARY KEY, parent INTEGER REFERENCES selfref(id) ON DELETE CASCADE)

statement ok
INSERT INTO selfref VALUES (1, NULL)

statement ok
INSERT INTO selfref VALUES (2, 1)

statement ok
INSERT INTO selfref VALUES (3, 2)

statement ok
DELETE FROM selfref WHERE id = 1

# Whole chain cascade-deleted; no infinite loop.
query II rowsort
SELECT id, parent FROM selfref
----

# ----- PRAGMA foreign_keys = OFF (pin 1) -------------------------------
statement ok
PRAGMA foreign_keys = OFF

statement ok
CREATE TABLE p7 (id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE c7 (cid INTEGER PRIMARY KEY, pid INTEGER REFERENCES p7(id) ON DELETE CASCADE)

# With FK off, orphan inserts succeed.
statement ok
INSERT INTO c7 VALUES (70, 999)

query II rowsort
SELECT cid, pid FROM c7
----
70
999

# Re-enable and verify violation now caught.
statement ok
PRAGMA foreign_keys = ON

statement ok
INSERT INTO p7 VALUES (1)

statement error
INSERT INTO c7 VALUES (71, 999)
