{
  "phase": "6p",
  "description": "Phase 6p gate — compound SELECT INTERSECT and EXCEPT (both with dedup; no ALL variants). Two new reserved keywords. Left-to-right fold semantics: UNION/UNION ALL→OR, INTERSECT→AND, EXCEPT→AND NOT. Row equality per 6b/6g (NULL==NULL, cross-type numeric). All phase1..6o fixtures must stay green.",
  "cases": [
    {
      "name": "intersect-basic",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (3);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (3);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (4);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a INTERSECT SELECT x FROM b ORDER BY x;", "expect": {"rows": [[2], [3]]}}
      ]
    },
    {
      "name": "intersect-no-overlap",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (2);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (3);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (4);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a INTERSECT SELECT x FROM b;",           "expect": {"rows": []}}
      ]
    },
    {
      "name": "intersect-duplicates-within-core-dedup",
      "description": "Duplicates within a core are deduped; INTERSECT is set semantics.",
      "program": [
        {"sql": "CREATE TABLE a (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "CREATE TABLE b (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO a VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "INSERT INTO b VALUES (1);",                            "expect": {"rows": []}},
        {"sql": "SELECT x FROM a INTERSECT SELECT x FROM b;",           "expect": {"rows": [[1]]}}
      ]
    },
    {
      "name": "intersect-identical-inputs",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",                          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",                            "expect": {"rows": []}},
