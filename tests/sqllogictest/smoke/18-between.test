statement ok
INSERT INTO s VALUES ('banana')

statement ok
INSERT INTO s VALUES ('cherry')

statement ok
INSERT INTO s VALUES ('date')

query T rowsort
SELECT x FROM s WHERE x BETWEEN 'b' AND 'd'
----
