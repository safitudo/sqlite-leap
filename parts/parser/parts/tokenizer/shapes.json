        "Integer": {
          "doc": "Integer literal (decimal digits, or hex 0x...; text span includes any 0x prefix; no sign — unary minus is an operator).",
          "fields": {
            "text": "str"
          }
        },
        "Real": {
          "doc": "Real literal (digits with '.' or exponent form 1e10 / 1.5E-3).",
          "fields": {
            "text": "str"
          }
        },
        "Str": {
          "doc": "Single-quoted string literal. Text span includes the surrounding quotes. Embedded quotes are doubled ('' ) — the tokenizer does NOT unescape.",
          "fields": {
            "text": "str"
          }
        },
        "Blob": {
          "doc": "BLOB literal: X'...' or x'...' with hex digits. Text span includes the leading X/x and both quotes.",
          "fields": {
            "text": "str"
          }
        },
        "Ident": {
          "doc": "Non-keyword identifier. Unquoted (ASCII alpha/_, then [A-Za-z0-9_]*) or double-quoted (\\\"name\\\") or bracket-quoted ([name]) or backtick-quoted (`name`). Text span includes surrounding quotes if any.",
          "fields": {
            "text": "str"
          }
        },
        "Param": {
          "doc": "Parameter placeholder: '?', '?NNN', ':name', '@name', '$name'. Text span includes the leading sigil.",
          "fields": {
            "text": "str"
          }
        },
