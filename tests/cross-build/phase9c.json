{
  "phase": "9c",
  "description": "Phase 9c gate — DML keeps indexes live. INSERT appends to every index on the table. DELETE removes from every index. UPDATE skips indexes unaffected by SET; affected indexes get OLD-delete + NEW-insert. 3 new VDBE opcodes: IdxOpenWrite, IdxInsert, IdxDelete. New invariants 34-36. max_invariant=36. Non-goals: splits (9d), UNIQUE (9g), PK auto-index (9f), DROP INDEX (9f). All prior phase fixtures must stay green.",
  "cases": [
    {
      "name": "insert-after-create-index-visible-via-equality",
      "description": "CREATE INDEX on empty table, then INSERT — new row findable via equality planner.",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",        "expect": {"rows": []}},
        {"sql": "CREATE INDEX idx_x ON t (x);",       "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (42);",         "expect": {"rows": []}},
        {"sql": "SELECT x FROM t WHERE x = 42;",      "expect": {"rows": [[42]]}}
      ]
    },
    {
      "name": "insert-multiple-after-create-index",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",        "expect": {"rows": []}},
        {"sql": "CREATE INDEX idx_x ON t (x);",       "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",          "expect": {"rows": []}},
        {"sql": "SELECT x FROM t WHERE x = 2;",       "expect": {"rows": [[2]]}},
        {"sql": "SELECT x FROM t WHERE x = 3;",       "expect": {"rows": [[3]]}}
      ]
    },
    {
      "name": "insert-duplicate-key-both-findable",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",           "expect": {"rows": []}},
        {"sql": "CREATE INDEX idx_x ON t (x);",          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (7);",             "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (7);",             "expect": {"rows": []}},
        {"sql": "SELECT x FROM t WHERE x = 7;",          "expect": {"rows": [[7], [7]]}}
      ]
    },
    {
      "name": "insert-null-indexed-col-not-findable-by-equality",
      "description": "INSERT with NULL indexed col adds a NULL cell; x = NULL never matches (3VL).",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER, y INTEGER);",                   "expect": {"rows": []}},
        {"sql": "CREATE INDEX idx_x ON t (x);",                              "expect": {"rows": []}},
        {"sql": "INSERT INTO t (y) VALUES (100);",                           "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (5, 200);",                            "expect": {"rows": []}},
        {"sql": "SELECT y FROM t WHERE x = 5;",                              "expect": {"rows": [[200]]}}
      ]
    },
    {
      "name": "insert-mixed-with-backfill",
      "description": "CREATE INDEX backfills 3 rows, then 2 more INSERT — all visible.",
      "program": [
        {"sql": "CREATE TABLE t (x INTEGER);",        "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (1);",          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (2);",          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (3);",          "expect": {"rows": []}},
        {"sql": "CREATE INDEX idx_x ON t (x);",       "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (4);",          "expect": {"rows": []}},
        {"sql": "INSERT INTO t VALUES (5);",          "expect": {"rows": []}},
        {"sql": "SELECT x FROM t WHERE x = 4;",       "expect": {"rows": [[4]]}},
        {"sql": "SELECT x FROM t WHERE x = 2;",       "expect": {"rows": [[2]]}}
      ]
    },
