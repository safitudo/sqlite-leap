{
  "$schema": "../../../../schema/shape.schema.json",
  "owner": "/parts/parser/parts/update-stmt",

  "imports": {
    "Token":      "/parts/parser/parts/tokenizer",
    "TokenKind":  "/parts/parser/parts/tokenizer",
    "Expr":       "/parts/parser/parts/expr",
    "ParseError": "/parts/parser/parts/expr",
    "TableRef":   "/parts/parser/parts/select-stmt",
    "ResultColumn": "/parts/parser/parts/insert-stmt",
    "OrAction":   "/parts/parser/parts/insert-stmt",
    "parse_returning_opt": "/parts/parser/parts/returning-clause"
  },

  "types": {
    "UpdateAssignment": {
      "kind": "record",
      "doc": "One `col = expr` assignment inside a SET clause.",
      "fields": {
        "column": "string",
        "value":  "Expr"
      }
    },

    "FromClauseStub": {
      "kind": "record",
      "doc": "Forward-declared stub for an UPDATE-FROM clause. The eventual richer FromClause (multi-table + JOINs) is being authored by a parallel agent in select-stmt; for now this leaf parses a single bare table name and stores it here. When select-stmt's FromClause stabilizes, replace this with the imported FromClause and regenerate.",
      "fields": {
        "table": "string",
        "alias": { "optional": "string" }
      }
    },

    "UpdateStmt": {
      "kind": "record",
      "doc": "Parsed UPDATE statement. Covers OR-action prefix, SET assignments, optional FROM, optional WHERE, and RETURNING.",
      "fields": {
        "or_action":   { "optional": "OrAction" },
        "table":       "string",
        "assignments": { "list": "UpdateAssignment" },
        "from_clause": { "optional": "FromClauseStub" },
        "where_":      { "optional": "Expr" },
        "returning":   { "list": "ResultColumn" }
      }
    },

    "UpdateParseOk": {
      "kind": "record",
      "doc": "Successful parse: the UpdateStmt plus the index of the next token after the statement.",
      "fields": {
        "stmt": "UpdateStmt",
        "next": "u32"
      }
    }
  },

  "functions": {
    "parse_update": {
      "doc": "Parse `[UPDATE OR <action>] UPDATE <table> SET <col>=<expr>[, ...] [FROM <table> [AS alias]] [WHERE <expr>] [RETURNING <result_columns>]`.",
      "params": [
        { "name": "tokens", "type": { "borrow": { "list": "Token" } } },
        { "name": "start",  "type": "u32" }
      ],
      "returns": { "result": { "ok": "UpdateParseOk", "err": "ParseError" } }
    }
  }
}
