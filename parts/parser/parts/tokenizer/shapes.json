        },
        "Eof": {
          "doc": "End of input sentinel — emitted exactly once at stream end."
        }
      }
    },
    "Token": {
      "kind": "record",
      "doc": "A lexed token: kind, byte span into the source, 1-based line/column of the token's FIRST byte.",
      "fields": {
        "kind": "TokenKind",
        "byte_start": "u32",
        "byte_end": "u32",
        "line": "u32",
        "column": "u32"
      }
    },
    "LexError": {
      "kind": "record",
      "doc": "Lexical error. Tokenizer stops on first error. Message is an owned string so it survives the source buffer's lifetime.",
      "fields": {
        "byte_offset": "u32",
        "line": "u32",
        "column": "u32",
        "message": "string"
      }
    }
  },
  "functions": {
    "tokenize": {
      "doc": "Lex the entire `source` buffer into a token stream. Returns a list of Tokens ending with a single Eof on success, or a LexError on first lexical failure. Whitespace and comments (-- line, /* block */) are skipped (never emitted). Keyword recognition is case-insensitive (SELECT / Select / select lex to the same kind).",
      "params": [
        {
          "name": "source",
          "type": "str"
        }
      ],
      "returns": {
        "result": {
          "ok": {
            "list": "Token"
          },
          "err": "LexError"
        }
      }
    }
  }
