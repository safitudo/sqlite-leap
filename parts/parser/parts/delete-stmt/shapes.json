{
  "$schema": "../../../../schema/shape.schema.json",
  "owner": "/parts/parser/parts/delete-stmt",

  "imports": {
    "Token":      "/parts/parser/parts/tokenizer",
    "TokenKind":  "/parts/parser/parts/tokenizer",
    "Expr":       "/parts/parser/parts/expr",
    "ParseError": "/parts/parser/parts/expr",
    "ResultColumn": "/parts/parser/parts/insert-stmt"
  },

  "types": {
    "DeleteUsingStub": {
      "kind": "record",
      "doc": "Forward-declared stub for a DELETE-USING clause. Like update-stmt's FromClauseStub, this is a single-table placeholder until select-stmt's FromClause is rich enough to replace it.",
      "fields": {
        "table": "string",
        "alias": { "optional": "string" }
      }
    },

    "DeleteStmt": {
      "kind": "record",
      "doc": "Parsed DELETE statement: target table plus optional USING / WHERE / RETURNING.",
      "fields": {
        "table":     "string",
        "using":     { "optional": "DeleteUsingStub" },
        "where_":    { "optional": "Expr" },
        "returning": { "list": "ResultColumn" }
      }
    },

    "DeleteParseOk": {
      "kind": "record",
      "doc": "Successful parse output: the DeleteStmt plus the index of the next token after the statement.",
      "fields": {
        "stmt": "DeleteStmt",
        "next": "u32"
      }
    }
  },

  "functions": {
    "parse_delete": {
      "doc": "Parse `DELETE FROM <table> [USING <table> [AS alias]] [WHERE <expr>] [RETURNING <result_columns>]`.",
      "params": [
        { "name": "tokens", "type": { "borrow": { "list": "Token" } } },
        { "name": "start",  "type": "u32" }
      ],
      "returns": { "result": { "ok": "DeleteParseOk", "err": "ParseError" } }
    }
  }
}
